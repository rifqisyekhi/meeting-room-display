# Service AI Notulen Otomatis (FastAPI + Whisper), listen HANYA di 127.0.0.1:8000.
#
# Pasang:
#   sudo cp deploy/notulen-ai.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now notulen-ai
# Ubah batas memori tanpa menyunting file ini:
#   sudo systemctl edit notulen-ai      → [Service] MemoryMax=6G
#
# SESUAIKAN: User/Group harus sama dengan user yang menjalankan backend Express (pm2),
# supaya keduanya bisa membaca/menulis backend/data/notulen. Path repo juga.

[Unit]
Description=Service AI Notulen Otomatis (lokal)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=meetingroom
Group=meetingroom
WorkingDirectory=/srv/meeting-room-display/ai-service
ExecStart=/srv/meeting-room-display/ai-service/.venv/bin/python -m app
Restart=on-failure
RestartSec=10

# Prioritas rendah agar layanan lain (helpdesk, backend) tetap responsif.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=50
IOWeight=50

# Batas memori untuk seluruh service (API + worker). Server sekarang: RAM bebas ±4,8 GB,
# dan Ollama (qwen3:4b ±3 GB) berjalan di unit terpisah, tetapi tidak bersamaan dengan Whisper.
# Jika worker melewati batas, hanya worker yang dimatikan; job ditandai gagal dan API tetap hidup.
MemoryHigh=3G
MemoryMax=3500M

# Pengerasan dasar
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# read-only (bukan true): Python 3.11 dari uv berada di home user.
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
