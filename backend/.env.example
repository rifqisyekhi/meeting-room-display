PORT=3001

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/meeting_room_display?schema=public

GOOGLE_CALENDAR_ID=your-google-calendar-id@group.calendar.google.com
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
PRAYER_PROVINCE=DKI Jakarta
PRAYER_CITY=Kota Jakarta

# WhatsApp Approver Configuration
APPROVER_WHATSAPP_NUMBERS=628xxxxxxxxxx
BOT_SISKA_SEND_URL=http://127.0.0.1:3000/send-message

# ==========================================
# 3 AKUN MASTER / SEED AWAL (PERMANEN DI ENV)
# ==========================================
# 1. Role Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin Utama
ADMIN_EMAIL=admin@kemnaker.go.id

# 2. Role Approval (Pimpinan)
APPROVAL_USERNAME=approval
APPROVAL_PASSWORD=approval123
APPROVAL_NAME=Pimpinan Approval
APPROVAL_EMAIL=approval@kemnaker.go.id
APPROVAL1_USERNAME=approval1
APPROVAL1_PASSWORD=approval123

# 3. Role User (Pegawai)
USER_USERNAME=user
USER_PASSWORD=user123
USER_NAME=User Pegawai
USER_EMAIL=user@kemnaker.go.id
USER_ANDI_USERNAME=andipratama
USER_ANDI_PASSWORD=user123

# ==========================================
# KEAMANAN SESI (WAJIB DIISI DI PRODUKSI)
# ==========================================
# Kunci penanda tangan cookie login. Isi dengan string acak panjang.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Dibiarkan kosong -> kunci diacak tiap restart, semua sesi login gugur.
SESSION_SECRET=

# Token bersama untuk webhook balasan bot SisKA (/api/dashboard/whatsapp/reply).
# Jalur ini yang MENYETUJUI rapat. Dibiarkan kosong -> siapa pun yang bisa
# menjangkau server dapat meloloskan permohonan rapat.
# Isi nilai yang sama di sisi bot, dikirim lewat header x-webhook-token.
BOT_SISKA_WEBHOOK_TOKEN=

# Catatan: APPROVAL2_USERNAME / APPROVAL2_PASSWORD tidak dibaca kode mana pun.
# Kalau akun approval kedua memang dibutuhkan, pakai APPROVAL1_* yang sudah ada
# atau tambahkan dukungannya di getMasterAccounts().

# ==========================================
# NOTULEN OTOMATIS (khusus Admin, butuh PostgreSQL)
# ==========================================
# Service AI lokal (folder ai-service/). Jangan arahkan ke layanan cloud.
AI_SERVICE_URL=http://127.0.0.1:8000
# Sama dengan API_TOKEN di ai-service/.env (kosong = tanpa token, hanya untuk dev).
AI_SERVICE_TOKEN=
# Folder audio rapat. HARUS sama dengan STORAGE_DIR di ai-service/.env.
# Kosong = backend/data/notulen
NOTULEN_STORAGE_DIR=
# Batas ukuran unggahan file audio (MB).
NOTULEN_MAX_UPLOAD_MB=2048
