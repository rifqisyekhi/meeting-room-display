# Salin file ini menjadi .env.local untuk pengembangan lokal.
#
# VITE_DEMO_ROOM mengisi satu kartu ruangan dengan data contoh, supaya
# tampilan "sedang digunakan + booking berikutnya" bisa ditinjau tanpa
# menunggu rapat sungguhan. Kartunya selalu diberi badge "Data demo".
#
# Hanya berlaku saat `npm run dev`. Build produksi membuang kode demo
# sepenuhnya, jadi nilai ini tidak bisa bocor ke layar TV.
#
# Pilihan: ruangKonsultasi | ruangRapatBesar
# Kosongkan atau hapus barisnya untuk mematikan.
VITE_DEMO_ROOM=ruangKonsultasi

# Kredensial Login Pengguna (Ganti nilai password sesuai kebutuhan)
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=your_admin_password

VITE_APPROVAL1_USERNAME=approval1
VITE_APPROVAL1_PASSWORD=your_approval1_password

VITE_APPROVAL2_USERNAME=approval2
VITE_APPROVAL2_PASSWORD=your_approval2_password

VITE_USER_USERNAME=andipratama
VITE_USER_PASSWORD=your_user_password
