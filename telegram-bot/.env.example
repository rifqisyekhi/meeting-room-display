# Salin menjadi .env lalu isi. Jangan commit .env.

# ---- Telegram ----
# Token dari @BotFather. JANGAN kirim token ini lewat chat/WhatsApp:
# siapa pun yang punya token bisa mengambil alih bot. Kalau sudah pernah
# terkirim, cabut dan buat baru: @BotFather -> /revoke -> pilih bot.
TELEGRAM_BOT_TOKEN=

# Chat yang boleh memakai bot, pisahkan koma. WAJIB diisi — bot menolak start
# kalau kosong, karena tanpa ini siapa pun yang menemukan bot bisa menyetujui
# notulen rapat. Cara tahu chat id: kirim pesan ke bot, lalu buka
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# dan lihat result[].message.chat.id
ALLOWED_CHAT_IDS=

# ---- Backend (lewat LAN, bukan internet) ----
BACKEND_URL=http://192.168.223.207
# Harus sama dengan BOT_TELEGRAM_API_TOKEN di backend/.env.
# Buat yang acak dan panjang, misalnya:  openssl rand -hex 32
BOT_TELEGRAM_API_TOKEN=

# ---- Perilaku ----
# Jeda pengecekan rapat baru ke backend (detik).
POLL_BACKEND_SECONDS=120
# Folder tugas untuk penyusun notulen. Default: telegram-bot/antrian
# QUEUE_DIR=
# Model yang dipakai saat operator menjawab "Tidak". Kosong = ikut
# OLLAMA_MODEL di ai-service/.env (sekarang gemma3:4b).
LOCAL_LLM_MODEL=
