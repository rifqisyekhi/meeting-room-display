# =====================================================================
#  Konfigurasi Service AI Notulensi — salin menjadi .env lalu sesuaikan.
#  Semua perubahan perilaku cukup lewat file ini (tanpa mengubah kode).
# =====================================================================

# ---- Server (JANGAN ubah HOST ke 0.0.0.0) ----
HOST=127.0.0.1
PORT=8000
# Rahasia bersama dengan aplikasi Next.js (header X-API-Key). Kosong = tanpa token (dev saja).
API_TOKEN=
LOG_LEVEL=INFO

# ---- Penyimpanan ----
# Folder audio bersama dengan Next.js. Service hanya mau membaca file di dalam folder ini.
# Windows contoh: D:/Sakeh/Project/notulensi-otomatis/storage   Ubuntu contoh: /srv/notulensi/storage
STORAGE_DIR=../backend/data/notulen
DATA_DIR=./data

# ---- Whisper (speech-to-text) ----
# Server sekarang (4 vCPU, RAM ±4,8 GB bebas) : small  + cpu  + int8
# Server di-upgrade (8–16 vCPU, RAM 32 GB)     : turbo  + cpu  + int8
# Ada GPU NVIDIA                               : turbo / large-v3 + cuda + float16
# DILARANG model berakhiran .en / distil-* (khusus bahasa Inggris). tiny/base: akurasi rendah.
WHISPER_MODEL=small
# Model yang boleh dipilih admin saat menekan "Proses" (WHISPER_MODEL selalu termasuk).
# Server sekarang (RAM bebas ±4,8 GB): small,medium,turbo masih muat karena tahap tidak berjalan bersamaan.
WHISPER_ALLOWED_MODELS=small,medium,turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Jumlah thread CPU untuk transkripsi & diarization. Sisakan minimal 1 core untuk layanan lain.
WHISPER_CPU_THREADS=3
WHISPER_DOWNLOAD_ROOT=./models
WHISPER_LANGUAGE=id
# 5 = lebih akurat; 1 = ±2x lebih cepat di CPU.
WHISPER_BEAM_SIZE=5
# Isi istilah/nama khas instansi agar ejaannya benar (maks. ±600 karakter).
WHISPER_INITIAL_PROMPT="Notulen rapat dinas dalam bahasa Indonesia. Pembahasan agenda, keputusan, dan tindak lanjut oleh peserta rapat."
WHISPER_VAD_MIN_SILENCE_MS=500
WHISPER_UNLOAD_AFTER_JOB=true
# Audio didekode per jendela (detik) agar RAM tidak tumbuh mengikuti durasi rapat.
AUDIO_WINDOW_SECONDS=600
# Ambang RAM bebas minimal sebelum memuat Whisper. 0 = otomatis (small 1200, medium/turbo 2400, large 4000 MB).
WHISPER_MIN_FREE_RAM_MB=0

# ---- Pemisahan pembicara (sherpa-onnx) — OPSIONAL ----
# Ringan (ONNX, tanpa torch, tanpa token). Unduh model sekali: python scripts/download_models.py --diarization
ENABLE_DIARIZATION=false
# Lebih kecil = lebih banyak pembicara terdeteksi (bila jumlah pembicara tidak diisi per rapat).
DIARIZATION_THRESHOLD=0.85
DIARIZATION_MIN_SPEAKER_SHARE=0.02
DIARIZATION_MIN_SPEAKER_SECONDS=20
# RAM bebas minimal = dasar + per jam audio (rapat 6 jam ≈ 3.500 MB). Jika kurang, transkrip
# tetap disimpan tanpa label pembicara.
DIARIZATION_MIN_FREE_RAM_MB=500
DIARIZATION_RAM_MB_PER_HOUR=500
SPEAKER_MERGE_GAP_SECONDS=1.5

# ---- Hugging Face ----
HF_HOME=./models/hf
# Set true setelah semua model terunduh agar tidak pernah mengakses internet.
HF_HUB_OFFLINE=false

# ---- Worker ----
# Prioritas rendah (Linux nice 0..19) agar layanan lain tetap responsif.
WORKER_NICE=10
JOB_MAX_ATTEMPTS=3

# ---- LLM (Ollama lokal) ----
OLLAMA_URL=http://127.0.0.1:11434
# Server sekarang: qwen3:4b | RAM 32 GB: qwen3:8b | GPU 16 GB+: qwen3:14b
OLLAMA_MODEL=qwen3:4b
# Model Ollama yang boleh dipilih per rapat (pisahkan koma). Kosong = semua yang sudah di-pull.
OLLAMA_ALLOWED_MODELS=
# Setelah job selesai: "0" = model langsung dilepas dari RAM.
OLLAMA_KEEP_ALIVE=0
# Di antara panggilan dalam satu job (agar model tidak dimuat ulang tiap potongan).
OLLAMA_KEEP_ALIVE_IN_JOB=5m
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
# Batasi thread CPU Ollama (default Ollama = semua core).
OLLAMA_NUM_THREAD=3
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=1800
LLM_MIN_FREE_RAM_MB=3500
# Panjang potongan transkrip per panggilan LLM (karakter).
SUMMARY_CHUNK_CHARS=12000
SUMMARY_REDUCE_MAX_CHARS=12000

# ---- LLM cloud: Claude (Anthropic API) — OPSIONAL ----
# PERHATIAN: teks transkrip dikirim ke server Anthropic (di luar kantor). Karena itu Claude
# hanya bisa dipilih untuk rapat yang oleh admin diklasifikasikan "Biasa"; rapat Rahasia
# dan pemrosesan otomatis setelah rapat selalu memakai Ollama lokal.
# Kosong = Claude tidak ditawarkan. Buat kunci di console.anthropic.com.
ANTHROPIC_API_KEY=
CLAUDE_MODELS=claude-opus-5-5
# low | medium | high | xhigh | max (lebih tinggi = lebih teliti, lebih mahal)
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=32000
CLAUDE_TIMEOUT_SECONDS=900
CLAUDE_CHUNK_CHARS=400000
